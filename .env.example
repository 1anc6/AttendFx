# Copy to .env for local development. .env is gitignored.
# These are DEV-ONLY values. Never reuse them anywhere real.

# --- Docker Compose Postgres ---
POSTGRES_DB=attendfx
POSTGRES_PORT=5432
AFX_OWNER_PASSWORD=owner_dev_pw

# --- Passwords given to the app roles by the migration ---
AFX_APP_PASSWORD=app_dev_pw
AFX_AUTH_PASSWORD=auth_dev_pw
AFX_SYNC_PASSWORD=sync_dev_pw

# --- Connection URLs (one per database role, see docs/ARCHITECTURE.md 4.2) ---
AFX_OWNER_DATABASE_URL=postgresql+psycopg://afx_owner:owner_dev_pw@localhost:5432/attendfx
AFX_APP_DATABASE_URL=postgresql://afx_app:app_dev_pw@localhost:5432/attendfx
AFX_AUTH_DATABASE_URL=postgresql://afx_auth:auth_dev_pw@localhost:5432/attendfx
AFX_SYNC_DATABASE_URL=postgresql://afx_sync:sync_dev_pw@localhost:5432/attendfx

# --- Seed data (fake accounts only) ---
AFX_SEED_PASSWORD=dev-password-change-me
